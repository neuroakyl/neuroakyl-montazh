# Скопируй в .env (в Git не попадает) и впиши свои ключи. Нужны не все: только под то, чем пользуешься.
ELEVENLABS_API_KEY=   # голос: elevenlabs.io → Profile → API keys
GEMINI_API_KEY=       # разбор референса и подписи: aistudio.google.com → Get API key (бесплатно)
TELEGRAM_BOT_TOKEN=   # по желанию: готовые ролики в Telegram — токен от @BotFather
